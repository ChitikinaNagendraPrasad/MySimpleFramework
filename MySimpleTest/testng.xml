<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">


<suite name="Automation Suite" parallel="tests" thread-count="3">
    <parameter name="browser" value="chrome"/>
    <parameter name="runMode" value="grid"/>
    <!--<parameter name="gridURL" value="http://localhost:4444/wd/hub"/>-->    
    <parameter name="gridURL" value="http://selenium-hub:4444/wd/hub"/>
    <parameter name="baseURL" value="https://automationexercise.com"/>
    <parameter name="headless" value="true"/>

	<listeners>
		<listener class-name="com.test.Listener.MyTestListener"></listener>
	</listeners>
	<test name="Test1">
		<parameter name="browser" value="Chrome"></parameter>
		<classes>
			<class name="com.test.TestCases.TestCases_1" />
		</classes>
	</test>
	
	<test name="Test2">
		<parameter name="browser" value="Firefox"></parameter>
		<classes>
			<class name="com.test.TestCases.TestCases_1" />
		</classes>
	</test>

	<test name="Test3">
		<parameter name="browser" value="Edge"></parameter>
		<classes>
			<class name="com.test.TestCases.TestCases_1" />
		</classes>
	</test>

</suite> 
